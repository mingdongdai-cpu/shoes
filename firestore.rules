// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: products
// Document ID: auto-generated
// Fields:
//   - name: string (required, unique) - Name of the product
//   - spec: number (required, positive) - Items per box
//   - price: number (required, positive) - Price per item
//   - stock: number (required, non-negative) - Total items in stock
//
// Collection: transactions
// Document ID: auto-generated
// Fields:
//   - productId: string (required) - ID of the related product
//   - type: string (required, 'in' or 'out') - Type of transaction
//   - quantity: number (required, positive) - Total items moved
//   - unitPrice: number (required, positive) - Price at time of transaction
//   - occurredAt: timestamp (required) - Unified operation time
//   - operatorUid: string (required) - Operator uid
//   - remark: string (optional) - Optional note
//
// Collection: expenses
// Document ID: auto-generated
// Fields:
//   - occurredAt: timestamp (required) - Unified expense time
//   - operatorUid: string (required) - Operator uid
//   - amount: number (required, positive) - Amount spent
//   - category: string (required) - Expense item/category
//   - remark: string (optional) - Optional remark
//
// Collection: debts
// Document ID: auto-generated
// Fields:
//   - customerName: string (required) - Customer owing the balance
//   - amount: number (required, positive) - Outstanding amount
//   - paidAmount: number (required, starts at zero) - Repaid amount
//   - occurredAt: timestamp (required) - Debt date
//   - operatorUid: string (required) - Operator uid
//
// Collection: customerOrders
// Document ID: auto-generated
// Fields:
//   - customerName: string (required) - Customer name
//   - orderDate: string (required, YYYY-MM-DD) - Business date without time
//   - isUnpaid: boolean (required for new orders) - Payment status marker
//   - paidAmount: number (required for new orders, non-negative) - Amount received
//   - hasDebtHistory: boolean (required for new orders) - Whether the order ever entered debt management
//   - items: list (required) - Product snapshots and ordered boxes
//   - totalAmount: number (required, non-negative) - Order total
//   - operatorUid: string (required) - Order account uid
//   - createdAt: timestamp (required) - Record creation timestamp
//
// Collection: orderCashCounts
// Document ID: YYYY-MM-DD
// Fields: recordDate, counts, totalAmount, operatorUid, createdAt, updatedAt
//
// Collection: orderDailyExpenses
// Document ID: auto-generated
// Fields: expenseDate, amount, remark, operatorUid, createdAt, updatedAt
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        roleOf(request.auth.uid) == 'admin' ||
        request.auth.token.email == "admin@topstar.com"
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        roleOf(request.auth.uid) in ['staff', 'admin'] ||
        request.auth.token.email in ["admin@topstar.com", "staff@topstar.com"]
      );
    }

    function isOrderUser() {
      return isAuthenticated() && (
        roleOf(request.auth.uid) == 'order' ||
        request.auth.token.email == "order@topstar.com"
      );
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidProduct(data) {
      return hasOnlyAllowedFields(['name', 'spec', 'price', 'stock', 'isActive', 'createdAt', 'lastOutAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.spec is number && data.spec > 0 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             (!('isActive' in data) || data.isActive is bool) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('lastOutAt' in data) || data.lastOutAt == null || data.lastOutAt is timestamp);
    }

    function isValidOrderProduct(data) {
      return hasOnlyAllowedFields(['name', 'spec', 'price']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.spec is number && data.spec > 0 &&
             data.price is number && data.price >= 0;
    }

    function isValidTransactionShape(data) {
      return hasOnlyAllowedFields(['productId', 'type', 'quantity', 'unitPrice', 'occurredAt', 'operatorUid', 'remark', 'sourceOrderSyncId']) &&
             data.productId is string &&
             data.type in ['in', 'out'] &&
             data.quantity is number && data.quantity > 0 &&
             data.unitPrice is number && data.unitPrice >= 0 &&
             data.occurredAt is timestamp &&
             data.operatorUid is string &&
             (!('sourceOrderSyncId' in data) || (data.sourceOrderSyncId is string && data.sourceOrderSyncId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
             (!('remark' in data) || (data.remark is string && data.remark.size() < 500));
    }

    function isValidNewTransaction(data) {
      return isValidTransactionShape(data) &&
             data.operatorUid == request.auth.uid &&
             (!('sourceOrderSyncId' in data) || (
               data.type == 'out' &&
               existsAfter(/databases/$(database)/documents/customerOrderSyncs/$(data.sourceOrderSyncId))
             ));
    }

    function isValidTransactionUpdate(data) {
      return isValidTransactionShape(data) &&
             data.operatorUid == resource.data.operatorUid &&
             !('sourceOrderSyncId' in resource.data) &&
             !('sourceOrderSyncId' in data);
    }

    function isValidExpense(data) {
      return hasOnlyAllowedFields(['occurredAt', 'operatorUid', 'amount', 'category', 'remark']) &&
             data.occurredAt is timestamp &&
             data.operatorUid is string &&
             data.operatorUid == request.auth.uid &&
             data.amount is number && data.amount >= 0 &&
             data.category is string && data.category.size() > 0 && data.category.size() < 100 &&
             (!('remark' in data) || (data.remark is string && data.remark.size() < 500));
    }

    function isValidDebt(data) {
      return hasOnlyAllowedFields(['customerName', 'amount', 'paidAmount', 'occurredAt', 'operatorUid']) &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() < 100 &&
             data.amount is number && data.amount > 0 &&
             data.paidAmount is number && data.paidAmount == 0 &&
             data.occurredAt is timestamp &&
             data.operatorUid is string &&
             data.operatorUid == request.auth.uid;
    }

    function isValidDebtUpdate(data) {
      return hasOnlyAllowedFields(['customerName', 'amount', 'paidAmount', 'occurredAt', 'operatorUid']) &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() < 100 &&
             data.amount is number && data.amount > 0 &&
             data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= data.amount &&
             data.occurredAt is timestamp &&
             data.operatorUid == resource.data.operatorUid &&
             data.operatorUid is string;
    }

    function isValidCustomerOrderShape(data) {
      return hasOnlyAllowedFields(['customerName', 'orderDate', 'isUnpaid', 'paidAmount', 'hasDebtHistory', 'items', 'totalAmount', 'operatorUid', 'createdAt', 'inventorySyncId']) &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
             data.orderDate is string && data.orderDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('isUnpaid' in data) || data.isUnpaid is bool) &&
             (!('paidAmount' in data) || (data.paidAmount is number && data.paidAmount >= 0)) &&
             (!('hasDebtHistory' in data) || data.hasDebtHistory is bool) &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.operatorUid is string &&
             (!('inventorySyncId' in data) || (data.inventorySyncId is string && data.inventorySyncId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
             data.createdAt is timestamp;
    }

    function isValidNewCustomerOrder(data) {
      return isValidCustomerOrderShape(data) &&
             data.isUnpaid is bool &&
             data.paidAmount is number && data.paidAmount >= 0 &&
             data.hasDebtHistory is bool &&
             data.hasDebtHistory == (data.isUnpaid || data.paidAmount < data.totalAmount) &&
             (!data.isUnpaid || data.paidAmount == 0) &&
             !('inventorySyncId' in data) &&
             !exists(/databases/$(database)/documents/customerOrderSyncs/$(data.orderDate)) &&
             data.operatorUid == request.auth.uid;
    }

    function isValidCustomerOrderUpdate(data) {
      return isValidCustomerOrderShape(data) &&
             data.isUnpaid is bool &&
             data.paidAmount is number && data.paidAmount >= 0 &&
             data.hasDebtHistory is bool &&
             ((!data.isUnpaid && data.paidAmount >= data.totalAmount) || data.hasDebtHistory) &&
             (!('hasDebtHistory' in resource.data) || resource.data.hasDebtHistory != true || data.hasDebtHistory == true) &&
             (!data.isUnpaid || data.paidAmount == 0);
    }

    function isValidCustomerOrderBusinessUpdate(data) {
      return isValidCustomerOrderUpdate(data) &&
             data.diff(resource.data).affectedKeys().hasOnly(['customerName', 'isUnpaid', 'paidAmount', 'hasDebtHistory', 'items', 'totalAmount']) &&
             (
               (!('inventorySyncId' in resource.data) && !('inventorySyncId' in data)) ||
               (
                 'inventorySyncId' in resource.data &&
                 'inventorySyncId' in data &&
                 data.inventorySyncId == resource.data.inventorySyncId &&
                 data.diff(resource.data).affectedKeys().hasOnly(['isUnpaid', 'paidAmount', 'hasDebtHistory'])
               )
             );
    }

    function isValidCustomerOrderSyncUpdate(data) {
      return isAdmin() &&
             isValidCustomerOrderUpdate(data) &&
             data.diff(resource.data).affectedKeys().hasOnly(['inventorySyncId']) &&
             (
               (
                 !('inventorySyncId' in resource.data) &&
                 data.inventorySyncId == data.orderDate &&
                 existsAfter(/databases/$(database)/documents/customerOrderSyncs/$(data.inventorySyncId))
               ) ||
               (
                 'inventorySyncId' in resource.data &&
                 !('inventorySyncId' in data) &&
                 !existsAfter(/databases/$(database)/documents/customerOrderSyncs/$(resource.data.inventorySyncId))
               )
             );
    }

    function isValidCustomerOrderSync(data, syncDate) {
      return data.keys().hasOnly(['orderDate', 'orderIds', 'transactionIds', 'lines', 'operatorUid', 'createdAt']) &&
             data.orderDate is string && data.orderDate == syncDate && data.orderDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.orderIds is list && data.orderIds.size() > 0 && data.orderIds.size() <= 450 &&
             data.transactionIds is list && data.transactionIds.size() > 0 && data.transactionIds.size() <= 100 &&
             data.lines is list && data.lines.size() == data.transactionIds.size() &&
             data.operatorUid is string && data.operatorUid == request.auth.uid &&
             data.createdAt is timestamp;
    }

    function isValidCashCounts(counts) {
      return counts is map &&
             counts.keys().hasOnly(['10000', '5000', '2000', '1000', '500', '200', '100', '50']) &&
             counts.keys().hasAll(['10000', '5000', '2000', '1000', '500', '200', '100', '50']) &&
             counts['10000'] is int && counts['10000'] >= 0 &&
             counts['5000'] is int && counts['5000'] >= 0 &&
             counts['2000'] is int && counts['2000'] >= 0 &&
             counts['1000'] is int && counts['1000'] >= 0 &&
             counts['500'] is int && counts['500'] >= 0 &&
             counts['200'] is int && counts['200'] >= 0 &&
             counts['100'] is int && counts['100'] >= 0 &&
             counts['50'] is int && counts['50'] >= 0;
    }

    function calculatedCashTotal(counts) {
      return counts['10000'] * 10000 +
             counts['5000'] * 5000 +
             counts['2000'] * 2000 +
             counts['1000'] * 1000 +
             counts['500'] * 500 +
             counts['200'] * 200 +
             counts['100'] * 100 +
             counts['50'] * 50;
    }

    function isValidOrderCashCount(data, cashDate) {
      return data.keys().hasOnly(['recordDate', 'counts', 'totalAmount', 'operatorUid', 'createdAt', 'updatedAt']) &&
             data.recordDate is string && data.recordDate == cashDate && data.recordDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             isValidCashCounts(data.counts) &&
             data.totalAmount is int && data.totalAmount == calculatedCashTotal(data.counts) &&
             data.operatorUid is string &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidOrderDailyExpense(data) {
      return data.keys().hasOnly(['expenseDate', 'amount', 'remark', 'operatorUid', 'createdAt', 'updatedAt']) &&
             data.expenseDate is string && data.expenseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.amount is int && data.amount > 0 &&
             data.remark is string && data.remark.size() > 0 && data.remark.size() <= 500 &&
             data.operatorUid is string &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection
    match /products/{productId} {
      // Staff and admins can read products
      allow read: if isStaff();
      
      // Only admins can create, update, or delete products. The client only exposes
      // deletion after a fresh query confirms that the product has no transactions.
      allow create: if isAdmin() && isValidProduct(request.resource.data);
      allow update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Sanitized catalog for order-entry-only accounts. Stock is intentionally excluded.
    match /orderCatalog/{productId} {
      allow read: if isStaff() || isOrderUser();
      allow create, update: if isAdmin() && isValidOrderProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Staff and admins can read transactions
      allow read: if isStaff();
      
      // Only admins can create, update, or delete transactions
      allow create: if isAdmin() && isValidNewTransaction(request.resource.data);
      allow update: if isAdmin() && isValidTransactionUpdate(request.resource.data);
      allow delete: if isAdmin() && (
        !('sourceOrderSyncId' in resource.data) ||
        !existsAfter(/databases/$(database)/documents/customerOrderSyncs/$(resource.data.sourceOrderSyncId))
      );
    }

    // Expenses collection
    match /expenses/{expenseId} {
      // Staff and admins can read expenses
      allow read: if isStaff();
      
      // Only admins can create, update, or delete expenses
      allow create: if isAdmin() && isValidExpense(request.resource.data);
      allow update: if isAdmin() && isValidExpense(request.resource.data);
      allow delete: if isAdmin();
    }

    // Debts collection
    match /debts/{debtId} {
      allow read: if isStaff();
      allow create: if isAdmin() && isValidDebt(request.resource.data);
      allow update: if isAdmin() && isValidDebtUpdate(request.resource.data);
      allow delete: if false;
    }

    // Customer orders are created by order-entry accounts. Their creator or an
    // admin can edit or delete them. The date and authorship remain immutable.
    match /customerOrders/{orderId} {
      allow read: if isAdmin() || isOrderUser();
      allow create: if isOrderUser() && isValidNewCustomerOrder(request.resource.data);
      allow update: if (
        isValidCustomerOrderBusinessUpdate(request.resource.data) &&
        (isAdmin() || (isOrderUser() && resource.data.operatorUid == request.auth.uid))
      ) || isValidCustomerOrderSyncUpdate(request.resource.data);
      allow delete: if !('inventorySyncId' in resource.data) && (
        isAdmin() || (isOrderUser() && resource.data.operatorUid == request.auth.uid)
      );
    }

    match /customerOrderSyncs/{syncDate} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidCustomerOrderSync(request.resource.data, syncDate);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /orderCashCounts/{cashDate} {
      allow read: if isOrderUser() || isAdmin();
      allow create: if isOrderUser() &&
        isValidOrderCashCount(request.resource.data, cashDate) &&
        request.resource.data.operatorUid == request.auth.uid;
      allow update: if isOrderUser() &&
        isValidOrderCashCount(request.resource.data, cashDate) &&
        request.resource.data.operatorUid == resource.data.operatorUid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOrderUser();
    }

    match /orderDailyExpenses/{expenseId} {
      allow read: if isOrderUser() || isAdmin();
      allow create: if isOrderUser() &&
        isValidOrderDailyExpense(request.resource.data) &&
        request.resource.data.operatorUid == request.auth.uid;
      allow update: if isOrderUser() &&
        isValidOrderDailyExpense(request.resource.data) &&
        request.resource.data.operatorUid == resource.data.operatorUid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOrderUser();
    }

    // Read-optimized totals maintained atomically with inventory and expense writes.
    match /analytics/{documentId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /analyticsMonths/{monthKey} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Users collection (for role-based access)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
